{
  "name": "@bitspacerlabs/rabbit-relay",
  "version": "1.1.1",
  "description": "Type-safe RabbitMQ framework for Node.js with reliable publishing, retries, DLQs, RPC, and explicit topology",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt",
    "docs/ai",
    "docs/api",
    "docs/guide/quickstart.md",
    "docs/guide/configuration.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./dedupe": {
      "types": "./dist/cjs/utils/dedupe.d.ts",
      "require": "./dist/cjs/utils/dedupe.js",
      "import": "./dist/esm/utils/dedupe.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/write-esm-package.cjs",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:package": "bash scripts/test-package-usage.sh",
    "test:unit": "npm run build && node --test test/unit/*.test.cjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/integration/*.integration.cjs"
  },
  "keywords": [
    "rabbitmq",
    "rabbit-relay",
    "amqplib",
    "amqp",
    "typescript",
    "events",
    "event-driven",
    "messaging",
    "message-queue",
    "microservices",
    "pubsub",
    "publisher-confirms",
    "retry",
    "dead-letter-queue",
    "rpc"
  ],
  "author": "BitSpacer Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitspacerlabs/rabbit-relay.git"
  },
  "bugs": {
    "url": "https://github.com/bitspacerlabs/rabbit-relay/issues"
  },
  "homepage": "https://bitspacerlabs.github.io/rabbit-relay/docs/",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitepress": "^2.0.0-alpha.12"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
